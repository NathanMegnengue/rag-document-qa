# Copy to .env and fill in. Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional
# API_KEY=choose-a-long-random-string     # if set, clients must send header X-API-Key
# ALLOWED_ORIGINS=http://localhost:3000    # comma-separated; empty = CORS disabled
# MAX_UPLOAD_MB=20
# MAX_DOCUMENTS=20
